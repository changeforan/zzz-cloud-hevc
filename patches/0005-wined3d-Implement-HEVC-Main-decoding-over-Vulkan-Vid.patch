+static StdVideoH265LevelIdc get_vk_h265_level(unsigned int luma_samples)
+{
+    /* MaxLumaPs from table A.8 of the H.265 specification. Levels which share
+     * a MaxLumaPs are collapsed to the lowest of the group; we have no bitrate
+     * information with which to distinguish them, and the decoder only needs a
+     * level that is not smaller than the stream's. */
+    static const struct
+    {
+        StdVideoH265LevelIdc level;
+        unsigned int max_luma_ps;
+    }
+    levels[] =
+    {
+        {STD_VIDEO_H265_LEVEL_IDC_6_0, 35651584},
+        {STD_VIDEO_H265_LEVEL_IDC_5_0,  8912896},
+        {STD_VIDEO_H265_LEVEL_IDC_4_0,  2228224},
+        {STD_VIDEO_H265_LEVEL_IDC_3_1,   983040},
+        {STD_VIDEO_H265_LEVEL_IDC_3_0,   552960},
+        {STD_VIDEO_H265_LEVEL_IDC_2_1,   245760},
+        {STD_VIDEO_H265_LEVEL_IDC_2_0,   122880},
+        {STD_VIDEO_H265_LEVEL_IDC_1_0,    36864},
+    };
+
+    if (luma_samples > levels[0].max_luma_ps)
+    {
+        ERR("Luma sample count %u exceeds the limit for any known level!\n", luma_samples);
+        return STD_VIDEO_H265_LEVEL_IDC_6_2;
+    }
+
+    for (unsigned int i = 0; i < ARRAY_SIZE(levels) - 1; ++i)
+    {
+        if (luma_samples > levels[i + 1].max_luma_ps)
+            return levels[i].level;
+    }
+    return STD_VIDEO_H265_LEVEL_IDC_1_0;
+}
+
+static VkVideoSessionParametersKHR create_h265_params(struct wined3d_decoder_vk *decoder_vk,
+        struct wined3d_context_vk *context_vk)
+{
+    VkVideoDecodeH265SessionParametersCreateInfoKHR h265_create_info =
+            {.sType = VK_STRUCTURE_TYPE_VIDEO_DECODE_H265_SESSION_PARAMETERS_CREATE_INFO_KHR};
+    VkVideoDecodeH265SessionParametersAddInfoKHR h265_add_info =
+            {.sType = VK_STRUCTURE_TYPE_VIDEO_DECODE_H265_SESSION_PARAMETERS_ADD_INFO_KHR};
+    VkVideoSessionParametersCreateInfoKHR create_info =
+            {.sType = VK_STRUCTURE_TYPE_VIDEO_SESSION_PARAMETERS_CREATE_INFO_KHR};
+    struct wined3d_device_vk *device_vk = wined3d_device_vk(decoder_vk->d.device);
+    const struct wined3d_vk_info *vk_info = &device_vk->vk_info;
+    unsigned int min_cb_size, width, height;
+    StdVideoH265ProfileTierLevel profile_tier_level = {0};
+    StdVideoH265SequenceParameterSet sps = {0};
+    StdVideoH265PictureParameterSet pps = {0};
+    StdVideoH265VideoParameterSet vps = {0};
+    StdVideoH265ScalingLists scaling_lists;
+    StdVideoH265DecPicBufMgr dpb_mgr = {0};
+    const DXVA_PicParams_HEVC *h265_params;
+    VkVideoSessionParametersKHR vk_params;
+    const DXVA_Qmatrix_HEVC *matrices;
+    VkResult vr;
+
+    h265_params = wined3d_buffer_load_sysmem(decoder_vk->d.parameters, &context_vk->c);
+    /* Unlike H.264, HEVC scaling lists are optional; only touch the
+     * quantisation matrix buffer when the stream actually uses them. */
+    matrices = h265_params->scaling_list_enabled_flag
+            ? wined3d_buffer_load_sysmem(decoder_vk->d.matrix, &context_vk->c) : NULL;
+
+    create_info.pNext = &h265_create_info;
+    create_info.videoSession = decoder_vk->vk_session;
+
+    h265_create_info.maxStdVPSCount = 1;
+    h265_create_info.maxStdSPSCount = 1;
+    h265_create_info.maxStdPPSCount = 1;
+    h265_create_info.pParametersAddInfo = &h265_add_info;
+
+    h265_add_info.stdVPSCount = 1;
+    h265_add_info.pStdVPSs = &vps;
+    h265_add_info.stdSPSCount = 1;
+    h265_add_info.pStdSPSs = &sps;
+    h265_add_info.stdPPSCount = 1;
+    h265_add_info.pStdPPSs = &pps;
+
+    /* DXVA gives the picture size in minimum coding blocks, so scale it back
+     * up to luma samples. */
+    min_cb_size = 1u << (h265_params->log2_min_luma_coding_block_size_minus3 + 3);
+    width = h265_params->PicWidthInMinCbsY * min_cb_size;
+    height = h265_params->PicHeightInMinCbsY * min_cb_size;
+
+    /* As with H.264, DXVA conveys no profile information; the HEVC DXVA
+     * specification ties DXVA_ModeHEVC_VLD_Main to the Main profile. */
+    profile_tier_level.general_profile_idc = STD_VIDEO_H265_PROFILE_IDC_MAIN;
+    profile_tier_level.general_level_idc = get_vk_h265_level(width * height);
+
+    /* DXVA only gives us sps_max_dec_pic_buffering_minus1 for the highest
+     * sub-layer, and no reorder/latency information at all. Fill sub-layer 0
+     * and let sps_sub_layer_ordering_info_present_flag stay clear. */
+    dpb_mgr.max_dec_pic_buffering_minus1[0] = h265_params->sps_max_dec_pic_buffering_minus1;
+    dpb_mgr.max_num_reorder_pics[0] = h265_params->NoPicReorderingFlag
+            ? 0 : h265_params->sps_max_dec_pic_buffering_minus1;
+    dpb_mgr.max_latency_increase_plus1[0] = 0;
+
+    /* Video parameter set. DXVA has no VPS-level data of its own; everything
+     * the decoder needs is duplicated in the SPS, so emit a minimal VPS whose
+     * only job is to be referenced by the SPS. */
+    vps.vps_video_parameter_set_id = 0;
+    vps.vps_max_sub_layers_minus1 = 0;
+    vps.pDecPicBufMgr = &dpb_mgr;
+    vps.pProfileTierLevel = &profile_tier_level;
+    /* We have no HRD information, and it is not needed to reconstruct the
+     * image. This is also the field whose nested pointers caused
+     * VK_KHR_video_decode_h265 to be blocklisted in make_vulkan. */
+    vps.pHrdParameters = NULL;
+
+    sps.flags.sps_temporal_id_nesting_flag = 0;
+    sps.flags.separate_colour_plane_flag = h265_params->separate_colour_plane_flag;
+    /* As with H.264, DXVA defers cropping to the application. */
+    sps.flags.conformance_window_flag = 0;
+    sps.flags.sps_sub_layer_ordering_info_present_flag = 0;
+    sps.flags.scaling_list_enabled_flag = h265_params->scaling_list_enabled_flag;
+    /* DXVA always supplies a quantisation matrix buffer, so if scaling lists
+     * are enabled at all we treat them as present in the SPS. */
+    sps.flags.sps_scaling_list_data_present_flag = h265_params->scaling_list_enabled_flag;
+    sps.flags.amp_enabled_flag = h265_params->amp_enabled_flag;
+    sps.flags.sample_adaptive_offset_enabled_flag = h265_params->sample_adaptive_offset_enabled_flag;
+    sps.flags.pcm_enabled_flag = h265_params->pcm_enabled_flag;
+    sps.flags.pcm_loop_filter_disabled_flag = h265_params->pcm_loop_filter_disabled_flag;
+    sps.flags.long_term_ref_pics_present_flag = h265_params->long_term_ref_pics_present_flag;
+    sps.flags.sps_temporal_mvp_enabled_flag = h265_params->sps_temporal_mvp_enabled_flag;
+    sps.flags.strong_intra_smoothing_enabled_flag = h265_params->strong_intra_smoothing_enabled_flag;
+    /* We have no VUI parameters; they are not needed to construct the image. */
+    sps.flags.vui_parameters_present_flag = 0;
+    sps.flags.sps_extension_present_flag = 0;
+
+    sps.chroma_format_idc = h265_params->chroma_format_idc;
+    sps.pic_width_in_luma_samples = width;
+    sps.pic_height_in_luma_samples = height;
+    /* See the H.264 path s.v. seq_parameter_set_id: the IDs only need to be
+     * self-consistent, since we submit exactly one of each per frame. */
+    sps.sps_video_parameter_set_id = 0;
+    sps.sps_max_sub_layers_minus1 = 0;
+    sps.sps_seq_parameter_set_id = 0;
+    sps.bit_depth_luma_minus8 = h265_params->bit_depth_luma_minus8;
+    sps.bit_depth_chroma_minus8 = h265_params->bit_depth_chroma_minus8;
+    sps.log2_max_pic_order_cnt_lsb_minus4 = h265_params->log2_max_pic_order_cnt_lsb_minus4;
+    sps.log2_min_luma_coding_block_size_minus3 = h265_params->log2_min_luma_coding_block_size_minus3;
+    sps.log2_diff_max_min_luma_coding_block_size = h265_params->log2_diff_max_min_luma_coding_block_size;
+    sps.log2_min_luma_transform_block_size_minus2 = h265_params->log2_min_transform_block_size_minus2;
+    sps.log2_diff_max_min_luma_transform_block_size = h265_params->log2_diff_max_min_transform_block_size;
+    sps.max_transform_hierarchy_depth_inter = h265_params->max_transform_hierarchy_depth_inter;
+    sps.max_transform_hierarchy_depth_intra = h265_params->max_transform_hierarchy_depth_intra;
+    sps.num_short_term_ref_pic_sets = h265_params->num_short_term_ref_pic_sets;
+    sps.num_long_term_ref_pics_sps = h265_params->num_long_term_ref_pics_sps;
+    sps.pcm_sample_bit_depth_luma_minus1 = h265_params->pcm_sample_bit_depth_luma_minus1;
+    sps.pcm_sample_bit_depth_chroma_minus1 = h265_params->pcm_sample_bit_depth_chroma_minus1;
+    sps.log2_min_pcm_luma_coding_block_size_minus3 = h265_params->log2_min_pcm_luma_coding_block_size_minus3;
+    sps.log2_diff_max_min_pcm_luma_coding_block_size = h265_params->log2_diff_max_min_pcm_luma_coding_block_size;
+    sps.pProfileTierLevel = &profile_tier_level;
+    sps.pDecPicBufMgr = &dpb_mgr;
+    sps.pScalingLists = h265_params->scaling_list_enabled_flag ? &scaling_lists : NULL;
+    /* The short-term ref pic sets are parsed out of the slice header by the
+     * driver; DXVA passes wNumBitsForShortTermRPSInSlice for that purpose. */
+    sps.pShortTermRefPicSet = NULL;
+    sps.pLongTermRefPicsSps = NULL;
+    sps.pSequenceParameterSetVui = NULL;
+    sps.pPredictorPaletteEntries = NULL;
+
+    pps.flags.dependent_slice_segments_enabled_flag = h265_params->dependent_slice_segments_enabled_flag;
+    pps.flags.output_flag_present_flag = h265_params->output_flag_present_flag;
+    pps.flags.sign_data_hiding_enabled_flag = h265_params->sign_data_hiding_enabled_flag;
+    pps.flags.cabac_init_present_flag = h265_params->cabac_init_present_flag;
+    pps.flags.constrained_intra_pred_flag = h265_params->constrained_intra_pred_flag;
